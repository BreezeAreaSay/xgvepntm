---
import { contacts, phoneHref } from '../data/contacts';

const missing = [
  !contacts.city && 'city',
  !contacts.address && 'address',
  !contacts.phone && 'phone',
  !contacts.yandexMapEmbedUrl && 'yandexMapEmbedUrl',
  contacts.workingHours.length === 0 && 'workingHours',
].filter((value): value is string => typeof value === 'string');
---

<section class="contacts" id="contacts">
  <div class="wrap">
    <div class="section-head">
      <h2 class="display">Контакты и <span class="accent">как нас найти</span></h2>
    </div>

    <div class="contacts__grid">
      <div class="contacts__info">
        {
          contacts.address && (
            <div class="contacts__row">
              <h3 class="display contacts__label">Адрес</h3>
              <p class="contacts__value">
                {contacts.city && `${contacts.city}, `}
                {contacts.address}
              </p>
            </div>
          )
        }

        {
          contacts.phone && (
            <div class="contacts__row">
              <h3 class="display contacts__label">Телефон</h3>
              <p class="contacts__value">
                <a href={phoneHref(contacts.phone)}>{contacts.phone}</a>
              </p>
            </div>
          )
        }

        {
          contacts.workingHours.length > 0 && (
            <div class="contacts__row">
              <h3 class="display contacts__label">Часы работы</h3>
              <ul class="contacts__hours" role="list">
                {contacts.workingHours.map((entry) => (
                  <li>
                    <span>{entry.days}</span>
                    <span>{entry.hours}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <div class="contacts__row">
          <h3 class="display contacts__label">Посадка</h3>
          <p class="contacts__value">
            Свободная — бронь не нужна, столик занимаете сами.
          </p>
        </div>

        {
          contacts.socials.length > 0 && (
            <div class="contacts__row">
              <h3 class="display contacts__label">Мы в сети</h3>
              <p class="contacts__value contacts__socials">
                {contacts.socials.map((social) => (
                  <a href={social.url} target="_blank" rel="noopener noreferrer">
                    {social.label}
                  </a>
                ))}
              </p>
            </div>
          )
        }

        {
          missing.length > 0 && (
            <p class="todo-note">
              Не заполнено в <code>src/data/contacts.ts</code>:{' '}
              {missing.map((field) => (
                <code>{field}</code>
              ))}
              . Блоки скрыты, пока данных нет.
            </p>
          )
        }
      </div>

      <div class="contacts__map">
        {
          contacts.yandexMapEmbedUrl ? (
            <iframe
              src={contacts.yandexMapEmbedUrl}
              title="Карта: как нас найти"
              loading="lazy"
              allowfullscreen
            />
          ) : (
            <div class="contacts__map-stub">
              <p class="todo-note">
                Карта появится, когда вы добавите <code>yandexMapEmbedUrl</code>.
                Код виджета берётся в конструкторе карт Яндекса.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contacts__grid {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .contacts__info { display: flex; flex-direction: column; gap: 1.5rem; }

  .contacts__label {
    margin: 0 0 0.3rem;
    color: var(--c-accent);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
  }

  .contacts__value { margin: 0; font-size: 1.05rem; }
  .contacts__value a { text-decoration: none; }
  .contacts__value a:hover { text-decoration: underline; }

  .contacts__socials { display: flex; gap: 1rem; flex-wrap: wrap; }

  .contacts__hours { margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .contacts__hours li { display: flex; justify-content: space-between; gap: 1rem; max-width: 16rem; }
  .contacts__hours span:last-child { color: var(--c-text-muted); }

  .contacts__map {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: clip;
    background: var(--c-bg-elevated);
  }
  .contacts__map iframe { width: 100%; height: 100%; border: 0; }

  .contacts__map-stub { display: grid; place-items: center; height: 100%; padding: 1.5rem; }

  @media (max-width: 820px) {
    .contacts__grid { grid-template-columns: 1fr; }
  }
</style>
