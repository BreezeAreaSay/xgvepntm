---
import { contacts, phoneHref } from '../data/contacts';

// Пункт «Доставка» показывается только когда есть сам раздел:
// ссылка на якорь, которого нет на странице, никуда не ведёт.
const links = [
  { href: '#menu', label: 'Меню' },
  ...(contacts.yandexEdaUrl ? [{ href: '#delivery', label: 'Доставка' }] : []),
  { href: '#reviews', label: 'Отзывы' },
  { href: '#contacts', label: 'Контакты' },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a class="header__brand display" href="#top">
      Джан Лян <span class="accent">Малатан</span>
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    {
      contacts.phone && (
        <a class="header__phone display" href={phoneHref(contacts.phone)}>
          {contacts.phone}
        </a>
      )
    }
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(0, 0, 0, 0.82);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--c-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 4rem;
    flex-wrap: wrap;
  }

  .header__brand {
    font-size: 1.15rem;
    color: var(--c-text);
    text-decoration: none;
    margin-right: auto;
  }

  .header__nav { display: flex; gap: clamp(0.75rem, 2vw, 1.75rem); flex-wrap: wrap; }

  .header__nav a {
    color: var(--c-text);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.35rem;
    border-bottom: 2px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .header__nav a:hover { color: var(--c-accent); border-color: var(--c-accent); }

  .header__phone { color: var(--c-accent); text-decoration: none; font-size: 1.1rem; }

  @media (max-width: 620px) {
    .header { position: static; }
    .header__brand { margin-right: 0; width: 100%; }
  }
</style>
