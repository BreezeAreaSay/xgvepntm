---
import { contacts } from '../data/contacts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__brand display">
      Джан Лян <span class="accent">Малатан</span>
    </p>
    <p class="footer__legal">
      © {year} {contacts.brandName}. Не является публичной офертой:
      актуальные цены и состав блюд уточняйте в заведении.
    </p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--c-border); padding-block: 2rem; }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .footer__brand { margin: 0; font-size: 1.1rem; }

  .footer__legal {
    margin: 0;
    color: var(--c-text-muted);
    font-size: 0.82rem;
    max-width: 52ch;
  }
</style>
