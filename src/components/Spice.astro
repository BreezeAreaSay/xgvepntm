---
import type { SpiceLevel } from '../data/menu';

type Props = { level: SpiceLevel };
const { level } = Astro.props;

const labels: Record<SpiceLevel, string> = {
  0: 'не острое',
  1: 'слабо острое',
  2: 'острое',
  3: 'очень острое',
};
---

{
  level > 0 && (
    <span class="spice" title={labels[level]}>
      <span class="visually-hidden">Острота: {labels[level]}</span>
      {Array.from({ length: level }).map(() => (
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
          <path
            d="M8.3 3.9C7.7 2.5 6.5 1.9 5.3 2.3"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M8 3.6C6.1 3.6 5.4 5.3 5.6 7.2c.3 3 1.6 5.4 2.9 6.7 1.1-1.7 1.9-4.3 1.9-6.7 0-2-.6-3.6-2.4-3.6Z"
            fill="currentColor"
          />
        </svg>
      ))}
    </span>
  )
}

<style>
  .spice {
    display: inline-flex;
    gap: 1px;
    color: var(--c-accent);
    vertical-align: middle;
  }
</style>
